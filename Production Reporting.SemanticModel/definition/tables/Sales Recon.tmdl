/// Monthly allocated volumes vs lease sales meter.
table 'Sales Recon'
	lineageTag: f71c3f1c-1a2c-41f3-8e2f-f68696093312

	column MonthStart
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 90bc950c-eab6-4086-bd20-47de9be45db8
		summarizeBy: none
		sourceColumn: MonthStart

		annotation UnderlyingDateTimeDataType = Date

	column Lease
		dataType: string
		isHidden
		lineageTag: 855a2031-060e-4497-bfdc-bd9f8037714b
		summarizeBy: none
		sourceColumn: Lease

	column Product
		dataType: string
		lineageTag: ebfd5930-f372-4ec7-81eb-7162e5531757
		summarizeBy: none
		sourceColumn: Product

	column AllocatedVolume
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 1a1925a8-60da-40e9-81ce-daa59a438a2f
		summarizeBy: sum
		sourceColumn: AllocatedVolume

	column SoldVolume
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 40691581-7678-4473-a7c2-69843af40f90
		summarizeBy: sum
		sourceColumn: SoldVolume

	partition 'Sales Recon' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_sales_reconciliation.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Renamed = Table.RenameColumns(Blanks, {{"month_start", "MonthStart"}, {"lease", "Lease"}, {"product", "Product"}, {"allocated_volume", "AllocatedVolume"}, {"sold_volume", "SoldVolume"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"MonthStart", type date}, {"Lease", type text}, {"Product", type text}, {"AllocatedVolume", type number}, {"SoldVolume", type number}}, "en-US")
				in
				    Typed

