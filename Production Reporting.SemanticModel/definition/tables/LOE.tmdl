/// Lease operating expenses by lease, month and category.
table LOE
	lineageTag: acaa0808-e74e-48bb-b3c3-a4d7979eaba5

	column MonthStart
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: aef6de8c-2fec-4dc8-8935-f05ac6611a15
		summarizeBy: none
		sourceColumn: MonthStart

		annotation UnderlyingDateTimeDataType = Date

	column Lease
		dataType: string
		isHidden
		lineageTag: af55798f-47e6-4903-8d97-db3d7f3ac5ac
		summarizeBy: none
		sourceColumn: Lease

	column 'Cost Category'
		dataType: string
		lineageTag: 88952f3d-f0dc-4dbb-a07f-6b25c5b83be2
		summarizeBy: none
		sourceColumn: Cost Category

	column AmountUSD
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 8ba19c8a-8852-4087-8115-e1fb97094d1a
		summarizeBy: sum
		sourceColumn: AmountUSD

	partition LOE = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_loe_monthly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Renamed = Table.RenameColumns(Blanks, {{"month_start", "MonthStart"}, {"lease", "Lease"}, {"category", "Cost Category"}, {"amount_usd", "AmountUSD"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"MonthStart", type date}, {"Lease", type text}, {"Cost Category", type text}, {"AmountUSD", type number}}, "en-US")
				in
				    Typed

