/// High-frequency SCADA readings (hourly, last 92 days); sensor spikes already set to blank.
table 'SCADA Hourly'
	lineageTag: 7d3221ea-3031-4475-9a04-4dc37304eaf4

	column 'Reading Time'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: fc750f6c-be35-4863-86ab-ad28a409ce86
		summarizeBy: none
		sourceColumn: Reading Time

	column ReadingDate
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 8f6ac41b-33fb-4b5e-b553-65826496c87a
		summarizeBy: none
		sourceColumn: ReadingDate

		annotation UnderlyingDateTimeDataType = Date

	column Hour
		dataType: int64
		lineageTag: 0ac8f9fd-cdd9-47b3-8cc2-0cc474facd2b
		summarizeBy: none
		sourceColumn: Hour

	column WellID
		dataType: string
		isHidden
		lineageTag: 82bf98ee-c27c-4e60-a1ca-98416ea57a44
		summarizeBy: none
		sourceColumn: WellID

	column TubingPsi
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: d44ea003-2529-489f-a180-e9a87de3dae0
		summarizeBy: sum
		sourceColumn: TubingPsi

	column CasingPsi
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 7b2e82a0-66ef-483d-baf2-207d5568f3cc
		summarizeBy: sum
		sourceColumn: CasingPsi

	column OilRateBopd
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: b5d93ed0-d2e8-48bf-86fc-e44019c17030
		summarizeBy: sum
		sourceColumn: OilRateBopd

	partition 'SCADA Hourly' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_scada_hourly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Renamed = Table.RenameColumns(Blanks, {{"reading_time", "Reading Time"}, {"reading_date", "ReadingDate"}, {"reading_hour", "Hour"}, {"well_id", "WellID"}, {"tubing_psi", "TubingPsi"}, {"casing_psi", "CasingPsi"}, {"oil_rate_bopd", "OilRateBopd"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Reading Time", type datetime}, {"ReadingDate", type date}, {"Hour", Int64.Type}, {"WellID", type text}, {"TubingPsi", type number}, {"CasingPsi", type number}, {"OilRateBopd", type number}}, "en-US")
				in
				    Typed

